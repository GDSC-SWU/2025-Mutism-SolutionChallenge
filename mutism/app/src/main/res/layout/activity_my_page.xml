<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/my_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_my_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:paddingBottom="100dp"
    android:paddingTop="50dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="25dp"
        android:orientation="vertical">

        <!-- Back button -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="30dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_right_arrow" />

        <!-- 소음 선택 -->
        <LinearLayout
            android:id="@+id/selected_noise_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_selected_noises"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_my_page_noise"
                android:textSize="17sp"
                android:textColor="@color/color_primary_dark" />

            <ImageView
                android:id="@+id/btn_select_noise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow2" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup_selected_noises"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            app:singleLine="false"
            app:chipSpacing="8dp" />

        <!-- 백색소음 선택 -->
        <LinearLayout
            android:id="@+id/white_noise_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_selected_white_noises"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_my_page_white_noise"
                android:textSize="17sp"
                android:textColor="@color/color_primary_dark" />

            <ImageView
                android:id="@+id/btn_select_white_noise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_right_arrow2" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_primary_light4"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp" />

        <!-- 이름 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="25dp">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="5"
                android:text="@string/text_my_page_name"
                android:textSize="14sp"
                android:textColor="@color/color_primary_dark" />

            <EditText
                android:id="@+id/tv_name_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:hint="@string/edt_my_page_hint_name"
                android:textSize="14sp"
                android:textColor="@color/color_primary"
                android:textColorHint="@color/color_primary_light3"
                android:backgroundTint="@color/color_primary_light3"
                android:padding="8dp" />
        </LinearLayout>

        <!-- 자폐 레벨 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="25dp">
        <TextView
            android:id="@+id/tv_autism_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text="@string/text_my_page_autism_level"
            android:textSize="14sp"
            android:textColor="@color/color_primary_dark" />

        <Spinner
            android:id="@+id/autism_level_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_my_page_spinner"
            android:dropDownWidth="match_parent"
            android:dropDownVerticalOffset="35dp"
            android:popupBackground="@color/white"/>
    </LinearLayout>


        <!-- 성별 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="25dp">
        <TextView
            android:id="@+id/tv_gender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text="@string/text_my_page_gender"
            android:textSize="14sp"
            android:textColor="@color/color_primary_dark" />

        <Spinner
            android:id="@+id/gender_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_my_page_spinner"
            android:dropDownWidth="match_parent"
            android:dropDownVerticalOffset="35dp"
            android:popupBackground="@color/white"/>

    </LinearLayout>


        <!-- 비상연락처 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="25dp">
        <TextView
            android:id="@+id/tv_emergency_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="6"
            android:text="@string/text_my_page_emergency_contact"
            android:textSize="14sp"
            android:textColor="@color/color_primary_dark" />

        <EditText
            android:id="@+id/tv_emergency_contact_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:hint="@string/edt_my_page_hint_contact"
            android:inputType="phone"
            android:maxLength="13"
            android:digits="0123456789"
            android:textSize="14sp"
            android:textColor="@color/color_primary"
            android:textColorHint="@color/color_primary_light3"
            android:backgroundTint="@color/color_primary_light3" />


    </LinearLayout>

        <!-- 진정 방법 -->
        <TextView
            android:id="@+id/tv_opinion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_my_page_relax_method"
            android:textSize="14sp"
            android:textColor="@color/color_primary_dark"
            android:layout_marginTop="25dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crv_method_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/color_primary_light3"
            app:cardCornerRadius="15dp">

            <EditText
                android:id="@+id/edt_relax_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:textSize="15sp"
                android:inputType="textMultiLine"
                android:maxLength="100"
                android:minLines="3"
                android:maxLines="10"
                android:gravity="top|start"
                android:scrollHorizontally="false"
                android:overScrollMode="never"
                android:imeOptions="actionDone"
                android:hint="@string/text_my_page_relax_method_example"
                android:textColorHint="@color/color_primary_light2"
                android:textColor="@color/color_primary_dark"
                android:background="@null" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 저장 버튼 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="25dp"
            android:padding="10dp"
            android:backgroundTint="@color/color_primary_light2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_my_page_save"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:layout_gravity="center" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
